{
  "id": "./meetings.html",
  "name": "LFE Meeting Records",
  "short_name": "LFE Meetings",
  "description": "LFE Office (IUB) meeting records: student/guardian, student, other and Monitor/SoD meetings, with PDF and Excel export.",
  "start_url": "./meetings.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f6f5f1",
  "theme_color": "#1f5f4a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New meeting", "url": "./meetings.html#new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
